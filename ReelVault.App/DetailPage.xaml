<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReelVault.App.DetailPage"
             Title="Item Detail">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" LineBreakMode="WordWrap" IsVisible="False" />

            <VerticalStackLayout x:Name="FormPanel" IsVisible="False" Spacing="10">

                <Label x:Name="CategoryLabel" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />

                <Label Text="Title" FontAttributes="Bold" />
                <Entry x:Name="TitleEntry" />

                <Label Text="Status" FontAttributes="Bold" />
                <Picker x:Name="StatusPicker" />

                <Label Text="Summary" FontAttributes="Bold" />
                <Editor x:Name="SummaryEditor" AutoSize="TextChanges" MinimumHeightRequest="60" />

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,8" />

                <!-- Food details: visible only when Category == "Food" -->
                <VerticalStackLayout x:Name="FoodPanel" Spacing="10">
                    <Label Text="Food details" FontAttributes="Bold" FontSize="16" />

                    <Label Text="Area" />
                    <Entry x:Name="AreaEntry" />

                    <Label Text="City" />
                    <Entry x:Name="CityEntry" />

                    <Label Text="Cuisine" />
                    <Entry x:Name="CuisineEntry" />

                    <Label Text="Price range" />
                    <Entry x:Name="PriceRangeEntry" />

                    <Label Text="Must try (comma-separated)" />
                    <Entry x:Name="MustTryEntry" />

                    <Label Text="Rating" />
                    <Entry x:Name="RatingEntry" />

                    <Label Text="Opening hours" />
                    <Entry x:Name="OpeningHoursEntry" />

                    <Label Text="Map query" />
                    <Entry x:Name="MapQueryEntry" />

                    <Label Text="Veg options" />
                    <Entry x:Name="VegOptionsEntry" />

                    <Label Text="Parking" />
                    <Entry x:Name="ParkingEntry" />
                </VerticalStackLayout>

                <!-- Travel details: visible only when Category == "Travel" -->
                <VerticalStackLayout x:Name="TravelPanel" Spacing="10">
                    <Label Text="Travel details" FontAttributes="Bold" FontSize="16" />

                    <Label Text="Area" />
                    <Entry x:Name="TravelAreaEntry" />

                    <Label Text="City" />
                    <Entry x:Name="TravelCityEntry" />

                    <Label Text="Place type" />
                    <Entry x:Name="PlaceTypeEntry" />

                    <Label Text="Best time to visit" />
                    <Entry x:Name="BestTimeToVisitEntry" />

                    <Label Text="Estimated cost" />
                    <Entry x:Name="EstimatedCostEntry" />

                    <Label Text="Highlights (comma-separated)" />
                    <Entry x:Name="HighlightsEntry" />

                    <Label Text="Activities (comma-separated)" />
                    <Entry x:Name="ActivitiesEntry" />

                    <Label Text="Map query" />
                    <Entry x:Name="TravelMapQueryEntry" />

                    <Label Text="Nearby places (comma-separated)" />
                    <Entry x:Name="NearbyPlacesEntry" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,8" />

                <Button x:Name="EnrichButton" Text="Enrich with Google" Clicked="OnEnrichClicked" HorizontalOptions="Fill" />
                <ActivityIndicator x:Name="EnrichLoadingIndicator" IsRunning="False" IsVisible="False" />

                <Label
                    x:Name="EnrichMessageLabel"
                    TextColor="Gray"
                    FontAttributes="Italic"
                    LineBreakMode="WordWrap"
                    IsVisible="False" />

                <!-- Enriched fields from Google Places - visually distinct from the reel-extracted
                     fields above, and never merged into them (see DetailPage.xaml.cs PopulateEnrichment). -->
                <VerticalStackLayout
                    x:Name="EnrichmentPanel"
                    Spacing="6"
                    IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light=#EEF3FF, Dark=#1C2440}"
                    Padding="12">

                    <Label Text="From Google" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Secondary}" />

                    <Label x:Name="EnrichedNameLabel" FontAttributes="Bold" LineBreakMode="WordWrap" />
                    <Label x:Name="EnrichedAddressLabel" LineBreakMode="WordWrap" />
                    <Label x:Name="EnrichedRatingLabel" />
                    <Label x:Name="EnrichedPriceLabel" />
                    <Label x:Name="EnrichedTypesLabel" LineBreakMode="WordWrap" />
                    <Label x:Name="EnrichedHoursLabel" LineBreakMode="WordWrap" />

                    <Label
                        x:Name="EnrichedMapsLinkLabel"
                        Text="Open in Google Maps"
                        TextColor="DodgerBlue"
                        TextDecorations="Underline"
                        IsVisible="False">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMapsLinkTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,8" />

                <Label Text="Your notes" FontAttributes="Bold" />
                <Editor x:Name="UserNotesEditor" AutoSize="TextChanges" MinimumHeightRequest="80" />

                <Button x:Name="SaveButton" Text="Save changes" Clicked="OnSaveClicked" HorizontalOptions="Fill" Margin="0,10,0,0" />
                <Button x:Name="ArchiveButton" Text="Archive (remove from list)" Clicked="OnArchiveClicked" HorizontalOptions="Fill" BackgroundColor="IndianRed" TextColor="White" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
