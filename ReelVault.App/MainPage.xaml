<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ReelVault.App"
             x:Class="ReelVault.App.MainPage"
             Title="Extract">

    <Grid>
    <ScrollView x:Name="ContentRoot">
        <VerticalStackLayout
            Padding="24,20,24,32"
            Spacing="14">

            <Label
                Text="Add a Reel 🎬"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Enter the place name and location, or paste a full caption below for richer extraction."
                Style="{StaticResource SubHeadline}" />

            <Label
                x:Name="ShareHintLabel"
                TextColor="{StaticResource Primary}"
                FontAttributes="Italic"
                FontSize="13"
                LineBreakMode="WordWrap"
                IsVisible="False"
                Margin="0,4,0,0" />

            <Label Text="Category" Style="{StaticResource MutedLabel}" Margin="0,10,0,0" />
            <Picker x:Name="CategoryPicker" SelectedIndexChanged="OnCategoryChanged" />

            <Label Text="Reel URL (optional)" Style="{StaticResource MutedLabel}" />
            <Entry
                x:Name="SourceUrlEntry"
                Placeholder="https://instagram.com/reel/..."
                Unfocused="OnSourceUrlUnfocused" />

            <Label
                x:Name="UrlWarningLabel"
                TextColor="{StaticResource AccentAmber}"
                FontSize="13"
                LineBreakMode="WordWrap"
                IsVisible="False" />

            <!-- Primary path: most shared reels arrive with a URL but no caption (Instagram
                 captions can't be copied from the share sheet), so name + location entry - not
                 caption pasting - is the default way to add a reel. See MainPage.xaml.cs
                 PrefillFromShare / OnSaveAndEnrichClicked. -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Enter the place name and location from the reel — we'll fetch the details. ✨"
                        Style="{StaticResource SectionHeaderLabel}"
                        FontSize="16" />

                    <Label Text="Place name" Style="{StaticResource MutedLabel}" />
                    <Entry x:Name="PlaceNameEntry" Placeholder="Place name (required)" />

                    <Label Text="Location (area, city)" Style="{StaticResource MutedLabel}" />
                    <Entry x:Name="LocationEntry" Placeholder="e.g. Indiranagar, Bangalore — optional" />

                    <Button
                        x:Name="SaveAndEnrichButton"
                        Text="Save &amp; Enrich"
                        Clicked="OnSaveAndEnrichClicked"
                        HorizontalOptions="Fill"
                        Margin="0,6,0,0" />

                    <ActivityIndicator x:Name="SaveAndEnrichLoadingIndicator" IsRunning="False" IsVisible="False" />

                    <Label
                        x:Name="NameLocationErrorLabel"
                        TextColor="{StaticResource ClosedRed}"
                        LineBreakMode="WordWrap"
                        IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <!-- Secondary path: only worth expanding when a full caption is actually available -
                 collapsed by default, auto-expanded by PrefillFromShare when a share arrives with
                 caption text. Everything inside is unchanged full-extraction behavior. -->
            <Button
                x:Name="CaptionSectionToggleButton"
                Text="Have a full caption? Paste it here (optional)"
                Clicked="OnToggleCaptionSectionClicked"
                HorizontalOptions="Start"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Secondary}"
                Margin="0,4,0,0" />

            <VerticalStackLayout x:Name="CaptionSection" Spacing="14" IsVisible="False">

                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Caption text (optional — paste if you have it)" Style="{StaticResource MutedLabel}" />
                        <Editor
                            x:Name="CaptionEditor"
                            Placeholder="Paste the Reel caption here..."
                            AutoSize="TextChanges"
                            MinimumHeightRequest="120" />

                        <Button
                            x:Name="ExtractButton"
                            Text="Extract"
                            Clicked="OnExtractClicked"
                            HorizontalOptions="Fill" />

                        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" />

                        <Label
                            x:Name="ErrorLabel"
                            TextColor="{StaticResource ClosedRed}"
                            LineBreakMode="WordWrap"
                            IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="ResultsPanel" Spacing="8" IsVisible="False">
                    <Border Style="{StaticResource CardStyle}" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Extracted data" Style="{StaticResource SectionHeaderLabel}" FontSize="16" />
                            <VerticalStackLayout x:Name="FieldsContainer" Spacing="4" />

                            <Label Text="Summary" Style="{StaticResource MutedLabel}" Margin="0,10,0,0" />
                            <Label x:Name="SummaryLabel" LineBreakMode="WordWrap" />

                            <Button
                                x:Name="SaveButton"
                                Text="Save"
                                Clicked="OnSaveClicked"
                                HorizontalOptions="Fill"
                                Margin="0,10,0,0" />

                            <ActivityIndicator x:Name="SaveLoadingIndicator" IsRunning="False" IsVisible="False" />

                            <Label
                                x:Name="SaveStatusLabel"
                                LineBreakMode="WordWrap"
                                IsVisible="False" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
    </Grid>

</ContentPage>
