<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Phase 4a adds Android alongside Mac Catalyst; iOS/Windows/Tizen are still later phases. -->
		<TargetFrameworks>net10.0-maccatalyst;net10.0-android</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>ReelVault.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>ReelVault.App</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.reelvault.app</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<!-- Per-platform: Android needs a numeric minimum API level, not the Catalyst OS version. -->
		<SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">21.0</SupportedOSPlatformVersion>

		<!-- Android tooling needs a JDK 21-or-earlier and the Android SDK; neither is installed to the
		     default search paths on this machine (no Android Studio), and `/usr/libexec/java_home` picks
		     up an unrelated JDK 23 install, which the Android build rejects (XA0030). Default to the
		     Phase 4a setup locations here so plain `dotnet build`/`dotnet test` from the solution root
		     work without extra flags; still overridable via -p:AndroidSdkDirectory=/-p:JavaSdkDirectory=
		     for other machines/CI. -->
		<AndroidSdkDirectory Condition="'$(TargetFramework)' == 'net10.0-android' and '$(AndroidSdkDirectory)' == ''">$(HOME)/Library/Android/sdk</AndroidSdkDirectory>
		<JavaSdkDirectory Condition="'$(TargetFramework)' == 'net10.0-android' and '$(JavaSdkDirectory)' == ''">$(HOME)/Library/Android/jdk/jdk-17.0.20+8/Contents/Home</JavaSdkDirectory>

		<!-- The installed maui-maccatalyst workload pack pins Xcode 26.4; this machine has 26.6. Skip the strict check until Microsoft ships a matching pack. -->
		<ValidateXcodeVersion>false</ValidateXcodeVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\ReelVault.Shared\ReelVault.Shared.csproj" />
	</ItemGroup>

</Project>
