<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Phase 6.5 (final design pass): a restrained MINIMALIST dark palette. Near-black surfaces,
         one accent (gold) used sparingly, true-neutral grays for hierarchy. No starfield, no heavy
         gradients - emphasis comes from spacing/type weight, not color or effects. Every key below
         is still a flat, single value (no Light/Dark pairs) - see Android's
         Platforms\Android\Resources\values\colors.xml too. -->

    <!-- The ONE accent - gold. Used only for key actions/highlights (buttons, ratings, links) -
         not decoratively elsewhere. This is the single value to change to re-accent the whole app. -->
    <Color x:Key="Primary">#E8B84B</Color>
    <!-- Deep, near-black text on the gold Primary background (gold never gets dark enough itself
         to read well with light text on top). -->
    <Color x:Key="PrimaryText">#141416</Color>
    <Color x:Key="Secondary">#F0CD7A</Color>
    <!-- Muted, desaturated teal - the only other tint in the app, used minimally (a Travel icon,
         a hairline border) rather than as a background color. -->
    <Color x:Key="Tertiary">#7FA0AD</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#141416</Color>

    <!-- True-neutral gray scale (no blue/sapphire tint) for calm typographic hierarchy. -->
    <Color x:Key="Gray100">#EDEDED</Color>
    <Color x:Key="Gray200">#D0D0D2</Color>
    <Color x:Key="Gray300">#A8A8AC</Color>
    <Color x:Key="Gray400">#86868A</Color>
    <Color x:Key="Gray500">#68686C</Color>
    <Color x:Key="Gray600">#3A3A3C</Color>
    <Color x:Key="Gray900">#1C1C1E</Color>
    <Color x:Key="Gray950">#121214</Color>

    <!-- Calm, near-flat page background - just enough top/bottom difference to avoid looking like
         a single flat swatch, nothing that reads as "designed drama". -->
    <Color x:Key="PageBackgroundTop">#0A0A0B</Color>
    <Color x:Key="PageBackgroundBottom">#101012</Color>

    <!-- Card surface - a hairline lighter than the page, with a subtle border for definition
         instead of a heavy shadow. -->
    <Color x:Key="CardBackground">#151517</Color>
    <Color x:Key="CardBorder">#242426</Color>

    <!-- Structural chrome (nav bar) - near-black, effectively the same weight as the page itself. -->
    <Color x:Key="SapphireDeep">#050505</Color>
    <!-- Hairline accent border for the (minimal, optional) "from the reel" card - muted, not a
         bright colored stroke. -->
    <Color x:Key="SapphireMid">#2A2A2D</Color>

    <Color x:Key="AccentAmber">#E8B84B</Color>

    <Color x:Key="SuccessGreen">#6FBE97</Color>
    <Color x:Key="ClosedRed">#E2907A</Color>

    <!-- Category tint, used minimally now (an icon color, a hairline border) rather than a colored
         tile background - see CategoryTheme.cs, which mirrors these for anything computed in C#. -->
    <Color x:Key="FoodAccent">#E8B84B</Color>
    <Color x:Key="TravelAccent">#7FA0AD</Color>

    <Color x:Key="ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Near-flat page background - a two-stop gradient so close in value it reads as "subtle
         depth", not a visible gradient. -->
    <LinearGradientBrush x:Key="PageGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PageBackgroundTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource PageBackgroundBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Hero image scrim (DetailPage): a simple two-stop dark fade, just enough for overlay text
         to stay legible - restrained, not a dramatic multi-stop treatment. -->
    <LinearGradientBrush x:Key="HeroScrimGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.0" />
        <GradientStop Color="#B3000000" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Food tile photo scrim (Phase 6.5: calmer/flatter than earlier passes) - a single
         near-uniform dark overlay so the photo reads as quiet ambiance, not a lit effect. -->
    <LinearGradientBrush x:Key="FoodTileScrimGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B30A0A0B" Offset="0.0" />
        <GradientStop Color="#CC0A0A0B" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
